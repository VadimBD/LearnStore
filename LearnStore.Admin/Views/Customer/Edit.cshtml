@model LearnStore.Admin.Models.AuthorViewModel

@{
    ViewData["Title"] = AdminLocalizer["EditAuthorTitle"];
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@AdminLocalizer["AuthorsLb"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="row">
    <div class="col-12 col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@ViewData["Title"]</h2>
                <form asp-action="Edit" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">@AdminLocalizer["AuthorIdLb"]</label>
                        <input asp-for="AuthorId" class="form-control" readonly />
                    </div>

                    @await Html.PartialAsync("_AuthorForm", Model)

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@AdminLocalizer["SaveBtn"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@AdminLocalizer["CancelBtn"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
