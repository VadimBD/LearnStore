@using LearnStore.Application.DTO
@model IEnumerable<OrderDto>

@{
    ViewData["Title"] = AdminLocalizer["OrdersLb"];
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <h1 class="h3">@ViewData["Title"]</h1>
</div>

<section class="mb-4">
    <form asp-action="Index" method="get" class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label">@AdminLocalizer["CustomerIdLb"]</label>
            <input name="CustomerId" class="form-control" />
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary">@AdminLocalizer["SearchBtn"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@AdminLocalizer["ResetBtn"]</a>
        </div>
    </form>
</section>

<section>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">@AdminLocalizer["OrderIdLb"]</th>
                            <th scope="col">@AdminLocalizer["CustomerIdLb"]</th>
                            <th scope="col">@AdminLocalizer["TotalLb"]</th>
                            <th scope="col">@AdminLocalizer["CreatedDateLb"]</th>
                            <th scope="col">@SharedLocalizer["ActionsLb"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model?.Any() ?? true)
                        {
                            <tr>
                                <td colspan="5"><div class="p-3 text-center text-muted">@AdminLocalizer["NoOrdersFound"]</div></td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.Customer?.Id</td>
                                    <td>
                                        @((order.Items?.Sum(i => i.PriceAtOrderTime * i.Quantity) ?? 0).ToString("C"))
                                    </td>
                                    <td>@order.OrderDate.ToString("g")</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">@AdminLocalizer["EditBtn"]</a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@order.Id">@AdminLocalizer["DeleteBtn"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@AdminLocalizer["DeleteOrderConfirmTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteForm" method="post" action="#">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>@AdminLocalizer["DeleteOrderConfirmMessage"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AdminLocalizer["CancelBtn"]</button>
                    <button type="submit" class="btn btn-danger">@AdminLocalizer["DeleteBtn"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var deleteModal = document.getElementById('deleteModal');
            if (!deleteModal) return;
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var form = document.getElementById('deleteForm');
                form.action = '/Order/' + id;
            });
        })();
    </script>
}
