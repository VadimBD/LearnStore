@model LearnStore.Admin.Models.OrderViewModel

@{
    ViewData["Title"] = AdminLocalizer["EditOrderTitle"];
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@AdminLocalizer["OrdersLb"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
}</nav>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="h6">@AdminLocalizer["OrderInfoLb"]</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-3">@AdminLocalizer["OrderIdLb"]</dt>
                    <dd class="col-sm-9">@Model.Order.Id</dd>

                    <dt class="col-sm-3">@AdminLocalizer["CustomerIdLb"]</dt>
                    <dd class="col-sm-9">@Model.Order.Customer?.Id</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Order.Id" />

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="h6">@AdminLocalizer["OrderItemsLb"]</h5>
                    @await Html.PartialAsync("_OrderItemsPartial", Model.Order.Items)
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="h6">@AdminLocalizer["AvailableProductsLb"]</h5>
                    <div class="list-group">
                        @for (int i = 0; i < Model.Products.Count(); i++)
                        {
                            var p = Model.Products.ElementAt(i);
                            var isSelected = Model.Order.Items.Any(it => it.Product?.Id == p.Id);
                            <label class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <input type="checkbox" name="Products" value="@p.Id" @(isSelected?"checked":"") class="form-check-input me-2" />
                                    <span>@p.Name</span>
                                    <small class="text-muted ms-2">@p.Price.ToString("C")</small>
                                </div>
                                <div>
                                    <input type="number" name="Quantities" value="@(Model.Order.Items.FirstOrDefault(it=>it.Product?.Id==p.Id)?.Quantity ?? 1)" min="1" class="form-control form-control-sm" style="width:6rem;" />
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@AdminLocalizer["SaveBtn"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@AdminLocalizer["CancelBtn"]</a>
            </div>
        </form>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="h6">@AdminLocalizer["OrderSummaryLb"]</h5>
                <p class="mb-1">@AdminLocalizer["TotalLb"]: <strong>@Model.TotalPrice.ToString("C")</strong></p>
                <p class="mb-0">@AdminLocalizer["StateLb"]</p>
                <select asp-for="Order.State" asp-items="Model.OrderStateSLI" class="form-select"></select>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
