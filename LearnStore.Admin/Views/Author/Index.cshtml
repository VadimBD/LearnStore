@using LearnStore.Application.DTO
@model IEnumerable<AuthorDto>

@{
    ViewData["Title"] = AdminLocalizer["AuthorsLb"] ?? "Authors";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <h1 class="h3 mb-2">@ViewData["Title"]</h1>
    <div class="mt-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus me-1" aria-hidden="true"></i>
            @AdminLocalizer["AddAuthorBtn"]
        </a>
    </div>
</div>

<section class="mb-4">
    <form method="get" class="row g-2">
        <div class="col-12 col-md-3">
            <label class="form-label">@AdminLocalizer["FirstNameLb"]</label>
            <input name="FirstName" class="form-control" value="@Context.Request.Query[" FirstName"]" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@AdminLocalizer["LastNameLb"]</label>
            <input name="LastName" class="form-control" value="@Context.Request.Query["LastName"]" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@AdminLocalizer["MiddleNameLb"]</label>
            <input name="MiddleName" class="form-control" value="@Context.Request.Query["MiddleName"]" />
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary">@AdminLocalizer["SearchBtn"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@AdminLocalizer["ResetBtn"]</a>
        </div>
    </form>
</section>

<section>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">@AdminLocalizer["FirstNameLb"]</th>
                            <th scope="col">@AdminLocalizer["LastNameLb"]</th>
                            <th scope="col">@AdminLocalizer["MiddleNameLb"]</th>
                            <th scope="col">@SharedLocalizer["ActionsLb"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model?.Any() ?? true)
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="p-3 text-center text-muted">@AdminLocalizer["NoAuthorsFound"]</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.Id</td>
                                    <td>@author.FirstName</td>
                                    <td>@author.LastName</td>
                                    <td>@author.MiddleName</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-primary">
                                                @AdminLocalizer["EditBtn"]
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@author.Id"
                                                    data-name="@author.FirstName @author.LastName">
                                                @AdminLocalizer["DeleteBtn"]
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@AdminLocalizer["DeleteAuthorConfirmTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteForm" method="post" action="#">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p id="deleteModalBody">@AdminLocalizer["DeleteAuthorConfirmMessage"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AdminLocalizer["CancelBtn"]</button>
                    <button type="submit" class="btn btn-danger">@AdminLocalizer["DeleteBtn"]</button>
                </div>
            </form>
        </div>
    </div>
    </div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var deleteModal = document.getElementById('deleteModal')
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget
                var id = button.getAttribute('data-id')
                var name = button.getAttribute('data-name')
                var body = deleteModal.querySelector('#deleteModalBody')
                body.textContent = (name ? name + ' - ' : '') + '@AdminLocalizer["DeleteAuthorConfirmMessage"]'
                var form = document.getElementById('deleteForm')
                form.action = '/Author/Delete/' + id
            })
        })();
    </script>
}
