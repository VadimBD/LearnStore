@using LearnStore.Application.DTO
@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = AdminLocalizer["ProductsLb"];
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <h1 class="h3">@ViewData["Title"]</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus me-1"></i>@AdminLocalizer["AddProductBtn"]</a>
    </div>
</div>

<section class="mb-4">
    <form asp-action="Index" method="get" class="row g-2">
        <div class="col-12 col-md-2">
            <label class="form-label">@AdminLocalizer["AuthorLb"]</label>
            <input name="AuthorId" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">@AdminLocalizer["CategoryLb"]</label>
            <input name="CategoryId" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">@AdminLocalizer["SellerLb"]</label>
            <input name="SellerId" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">@AdminLocalizer["ProductNameLb"]</label>
            <input name="ProductName" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">@AdminLocalizer["PriceLb"]</label>
            <input name="Price" class="form-control" />
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end gap-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="true" id="isActive" name="IsActive">
                <label class="form-check-label" for="isActive">@AdminLocalizer["IsActiveLb"]</label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-outline-primary">@AdminLocalizer["SearchBtn"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@AdminLocalizer["ResetBtn"]</a>
        </div>
    </form>
</section>

<section>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>@AdminLocalizer["NameLb"]</th>
                            <th>@AdminLocalizer["PriceLb"]</th>
                            <th>@AdminLocalizer["AuthorLb"]</th>
                            <th>@AdminLocalizer["CategoryLb"]</th>
                            <th>@AdminLocalizer["SellerLb"]</th>
                            <th>@AdminLocalizer["IsActiveLb"]</th>
                            <th>@SharedLocalizer["ActionsLb"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model?.Any() ?? true)
                        {
                            <tr>
                                <td colspan="8" class="text-center p-3 text-muted">@AdminLocalizer["NoProductsFound"]</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.Id</td>
                                    <td>@p.Name</td>
                                    <td>@p.Price.ToString("C")</td>
                                    <td>@p.Author?.FirstName @p.Author?.LastName</td>
                                    <td>@p.Category?.Name</td>
                                    <td>@p.Seller?.Name</td>
                                    <td>@(p.IsActive?AdminLocalizer["YesLb"]:AdminLocalizer["NoLb"])</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">@AdminLocalizer["DetailsBtn"]</a>
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">@AdminLocalizer["EditBtn"]</a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@p.Id">@AdminLocalizer["DeleteBtn"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@AdminLocalizer["DeleteProductConfirmTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteForm" method="post" action="#">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>@AdminLocalizer["DeleteProductConfirmMessage"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@AdminLocalizer["CancelBtn"]</button>
                    <button type="submit" class="btn btn-danger">@AdminLocalizer["DeleteBtn"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var deleteModal = document.getElementById('deleteModal');
            if (!deleteModal) return;
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var form = document.getElementById('deleteForm');
                form.action = '/Product/' + id;
            });
        })();
    </script>
}
