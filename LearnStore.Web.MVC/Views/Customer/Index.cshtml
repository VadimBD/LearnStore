@model LearnStore.Application.DTO.CustomerDto



<main class="customer-page container py-4">
    <header class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Name</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@WebAppLocalizer["BackToHomeBtn"]</a>
            <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@WebAppLocalizer["EditProfileBtn"]</a>
        </div>
    </header>

    <section aria-labelledby="purchased-heading" class="mb-4">
        <div class="mb-3">
            <label for="productSearch" class="form-label visually-hidden">@WebAppLocalizer["SearchPurchasedProductsLb"]</label>
            <div class="input-group">
                <input id="productSearch" type="search" class="form-control" placeholder="Search purchased products..." aria-label="Search purchased products">
                <button class="btn btn-outline-secondary" type="button" id="clearSearch">@WebAppLocalizer["ClearSearchBtn"]</button>
            </div>
        </div>

        <h2 id="purchased-heading" class="h5 mb-3">@WebAppLocalizer["PurchasedProductsLb"]</h2>

        @if (!Model.PurchasedProducts?.Any() ?? true)
        {
            <div class="alert alert-info">@WebAppLocalizer["MessageCustomerHasNoPurchases"]</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3" id="productsList">
                @foreach (var product in Model.PurchasedProducts)
                {
                    @await Html.PartialAsync("_CustomerProductItem", product)
                }
            </div>
        }
    </section>
</main>

@section Scripts {
    <script>
        (function(){
            const search = document.getElementById('productSearch');
            const clearBtn = document.getElementById('clearSearch');
            const list = document.getElementById('productsList');
            if (!search || !list) return;

            function filter(q){
                const value = q.trim().toLowerCase();
                const items = list.querySelectorAll('.product-col');
                items.forEach(col => {
                    const name = col.querySelector('.product-name')?.textContent?.toLowerCase() || '';
                    const desc = col.querySelector('.product-desc')?.textContent?.toLowerCase() || '';
                    const show = !value || name.includes(value) || desc.includes(value);
                    col.style.display = show ? '' : 'none';
                });
            }

            search.addEventListener('input', (e)=> filter(e.target.value));
            clearBtn.addEventListener('click', ()=>{ search.value=''; filter(''); search.focus(); });
        })();
    </script>
}
