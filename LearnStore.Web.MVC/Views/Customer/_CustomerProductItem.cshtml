@model LearnStore.Application.DTO.ProductDto

<article class="col product-col">
    <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h4 class="card-title h6 product-name">@Model.Name</h4>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="card-text text-muted mb-3 product-desc">@Model.Description</p>
            }
            <div class="mt-auto d-flex justify-content-end">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">@WebAppLocalizer["ProductDetailsBtn"]</a>
            </div>
        </div>
    </div>
</article>
