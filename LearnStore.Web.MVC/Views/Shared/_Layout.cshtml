<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LearnStore.Web.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">LearnStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@SharedLocalizer["HomeBtn"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="List">@WebAppLocalizer["Products"]</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="d-flex gap-2 me-2 align-items-center">
                <a class="btn btn-outline-primary btn-sm"
                   asp-controller="Home"
                   asp-action="SetLanguage"
                   asp-route-culture="uk"
                   asp-route-returnUrl="@Context.Request.Path">
                    UA
                </a>

                <a class="btn btn-outline-secondary btn-sm"
                   asp-controller="Home"
                   asp-action="SetLanguage"
                   asp-route-culture="en"
                   asp-route-returnUrl="@Context.Request.Path">
                    EN
                </a>
                
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    if (User.IsInRole("Seller"))
                    {
                        <a class="btn btn-outline-info btn-sm ms-2" asp-controller="Seller" asp-action="Index" >@WebAppLocalizer["MyAccountBtn"]</a>
                    }
                    else if (User.IsInRole("Customer"))
                    {
                        <a class="btn btn-outline-info btn-sm ms-2" asp-controller="Customer" asp-action="Index">@WebAppLocalizer["MyAccountBtn"]</a>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">@SharedLocalizer["Logout"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-success btn-sm ms-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">@SharedLocalizer["LoginBtn"]</a>
                }
                @await Component.InvokeAsync("CartSummary")
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
