@model LearnStore.Application.DTO.ProductDto

<article class="col">
    <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h4 class="card-title h6">@Model.Name</h4>
            <p class="card-text text-muted mb-3">@Model.Description</p>
            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@Model.Price.ToString("C")</span>
                <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">@SharedLocalizer["EditBtn"]</a>
            </div>
        </div>
    </div>
</article>
