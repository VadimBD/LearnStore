
@model LearnStore.Application.DTO.ProductDto

<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h3 class="card-title">@Model.Name</h3>
            <h5 class="card-subtitle mb-3 text-muted">@String.Format(WebAppLocalizer["PriceFormat"], Model.Price)</h5>

            <div class="mb-3">
                <h6>@WebAppLocalizer["Description"]</h6>
                <p>@Model.Description</p>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <strong>@WebAppLocalizer["Author"]</strong>
                    <div>@Model.Author?.FirstName @Model.Author?.LastName</div>
                </div>
                <div class="col-sm-4">
                    <strong>@WebAppLocalizer["Category"]</strong>
                    <div>@Model.Category?.Name</div>
                </div>
                <div class="col-sm-4">
                    <strong>@WebAppLocalizer["Seller"]</strong>
                    <div>@Model.Seller?.Name</div>
                </div>
            </div>

            @if (Model.ChildProducts != null && Model.ChildProducts.Any())
            {
                <div class="mb-3">
                    <h6>@WebAppLocalizer["ChildProducts"]</h6>
                    <ul class="list-group">
                        @foreach (var child in Model.ChildProducts)
                        {
                            <li class="list-group-item">
                                <a asp-action="Details" asp-route-id="@child.Id">@child.Name</a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <footer class="d-flex justify-content-between align-items-center mt-4">
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-secondary">@WebAppLocalizer["BackToList"]</a>
                </div>

                <div>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-cart-plus-fill me-2"></i>
                            @WebAppLocalizer["AddToCart"]
                        </button>
                    </form>
                </div>
            </footer>
        </div>
    </div>
</div>
