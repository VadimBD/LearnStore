@model LearnStore.Web.MVC.Models.ProductViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label">@WebAppLocalizer["Name"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">@WebAppLocalizer["Description"]</label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="AuthorId" class="form-label">@WebAppLocalizer["Author"]</label>
    <select asp-for="AuthorId" asp-items="ViewBag.Authors" class="form-select"></select>
    <span asp-validation-for="AuthorId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">@WebAppLocalizer["Category"]</label>
    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Price" class="form-label">@WebAppLocalizer["Price"]</label>
    <input asp-for="Price" class="form-control" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">@WebAppLocalizer["IsActive"]</label>
</div>

<div class="mb-3">
    <label class="form-label">@WebAppLocalizer["ChildProducts"]</label>
    <div class="row">
        @if (ViewBag.AllProducts is IEnumerable<LearnStore.Application.DTO.ProductDto> all)
        {
            foreach (var p in all)
            {
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ChildProducts" value="@p.Id" id="child_@p.Id" @(Model.ChildProducts.Contains(p.Id) ? "checked" : "") />
                        <label class="form-check-label" for="child_@p.Id">@p.Name</label>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-muted">@WebAppLocalizer["NoProductsAvailable"]</div>
        }
    </div>
</div>
