@model LearnStore.Web.MVC.Models.ProductListViewModel

@{
    ViewData["Title"] = WebAppLocalizer["Products"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@WebAppLocalizer["Products"]</h2>
        <div class="w-50">
            <label class="visually-hidden" for="productSearch">@WebAppLocalizer["SearchPlaceholder"]</label>
            <div class="input-group">
                <input id="productSearch" type="search" class="form-control" placeholder="@WebAppLocalizer["SearchPlaceholder"]" aria-label="Search products" />
                <button id="clearSearch" class="btn btn-outline-secondary" type="button">&times;</button>
            </div>
        </div>
    </div>

    <div id="productsGrid" class="row g-3">
        @foreach (var product in Model.Products ?? Enumerable.Empty<LearnStore.Application.DTO.ProductDto>())
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 product-card" data-name="@product.Name.ToLowerInvariant()" data-description="@((product.Description ?? string.Empty).ToLowerInvariant())">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@String.Format(WebAppLocalizer["PriceFormat"], product.Price)</h6>
                        <p class="card-text flex-grow-1">@((product.Description?.Length > 140) ? product.Description.Substring(0, 140) + "..." : product.Description)</p>

                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">@WebAppLocalizer["Details"]</a>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">@WebAppLocalizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@WebAppLocalizer["Inactive"]</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noResults" class="alert alert-info mt-4 d-none">@WebAppLocalizer["NoProductsFound"]</div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('productSearch');
            const clearBtn = document.getElementById('clearSearch');
            const productCards = Array.from(document.querySelectorAll('.product-card'));
            const noResults = document.getElementById('noResults');

            function normalize(str) {
                return (str || '').toLowerCase();
            }

            function filter(term) {
                const t = normalize(term);
                let visible = 0;
                productCards.forEach(card => {
                    const name = card.getAttribute('data-name') || '';
                    const desc = card.getAttribute('data-description') || '';
                    const match = name.includes(t) || desc.includes(t);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                noResults.classList.toggle('d-none', visible > 0);
            }

            // Debounce to avoid excessive work while typing
            function debounce(fn, delay) {
                let timer;
                return function (...args) {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(this, args), delay);
                };
            }

            const debouncedFilter = debounce(function () { filter(searchInput.value); }, 200);

            searchInput.addEventListener('input', debouncedFilter);
            clearBtn.addEventListener('click', () => { searchInput.value = ''; filter(''); searchInput.focus(); });

            // optional: support Enter to focus or trigger
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    filter('');
                }
            });
        })();
    </script>
}
