@model OrderViewModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title mb-3">@WebAppLocalizer["CreateOrder"]</h3>

                    <form asp-action="CreateOrder" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @{
                            var items = Model.Items?.ToList() ?? new List<LearnStore.Application.DTO.OrderItemDto>();
                        }

                        @if (!items.Any())
                        {
                            <div class="alert alert-info">@WebAppLocalizer["CartIsEmpty"]</div>
                        }
                        else
                        {
                            <ul class="list-group">
                                @for (int i = 0; i < items.Count; i++)
                                {
                                    <li class="list-group-item d-flex flex-column flex-md-row align-items-md-center">
                                        <div class="flex-grow-1 mb-2 mb-md-0">
                                            <h5 class="mb-1">@items[i].Product?.Name ?? WebAppLocalizer["UnknownProduct"]</h5>
                                            <small class="text-muted">@String.Format(WebAppLocalizer["PriceFormat"], items[i].PriceAtOrderTime)</small>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="Items[@i].Id" value="@items[i].Id" />

                                            <div class="input-group input-group-sm" style="width:120px">
                                                <button type="button" class="btn btn-outline-secondary" onclick="changeQty(@i, -1)">-</button>
                                                <input type="number"
                                                       name="Items[@i].Quantity"
                                                       id="Items[@i].Quantity"
                                                       class="form-control text-center"
                                                       value="@items[i].Quantity"
                                                       min="1" />
                                                <button type="button" class="btn btn-outline-secondary" onclick="changeQty(@i, 1)">+</button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="mt-3 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">@WebAppLocalizer["SubmitOrder"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")

<script>
    function changeQty(index, delta) {
        var id = 'Items_' + index + '__Quantity';
        var input = document.getElementById(id);
        if (!input) return;
        var val = parseInt(input.value || '0', 10) + delta;
        if (val < 1) val = 1;
        input.value = val;
    }
</script>
