@using Microsoft.Extensions.Localization
@inject IStringLocalizer<LearnStore.Localization.Resources.WebAppResource> WebAppLocalizer

@{
    ViewData["Title"] = WebAppLocalizer["OrderCompleteTitle"] ?? "Order complete";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h2 class="card-title mb-3">@ViewData["Title"]</h2>
                    <p class="lead mb-4">@WebAppLocalizer["OrderCompleteMessage"]</p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@WebAppLocalizer["BackToHomeBtn"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
